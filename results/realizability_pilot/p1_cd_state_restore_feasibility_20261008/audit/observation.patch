+bool SynchronousSlamToolbox::b0Status(std_srvs::Trigger::Request&,
+  std_srvs::Trigger::Response& resp)
+{
+  boost::mutex::scoped_lock lock(q_mutex_);
+  std::ostringstream out;
+  out << "{\"callbacks\":" << b0_callbacks_
+      << ",\"accepted\":" << b0_accepted_
+      << ",\"processed\":" << b0_processed_
+      << ",\"successful\":" << b0_successful_
+      << ",\"queue_size\":" << q_.size()
+      << ",\"in_flight\":" << (b0_in_flight_ ? "true" : "false") << "}";
+  resp.success = true;
+  resp.message = out.str();
+  return true;
+}
+
+bool SynchronousSlamToolbox::b0Dump(std_srvs::Trigger::Request&,
+  std_srvs::Trigger::Response& resp)
+{
+  boost::mutex::scoped_lock queue_lock(q_mutex_);
+  int expected = -1;
+  nh_.getParam("b0_expected_callbacks", expected);
+  if (expected < 0 || b0_callbacks_ != static_cast<uint64_t>(expected) ||
+      !q_.empty() || b0_in_flight_ || b0_processed_ != b0_accepted_) {
+    resp.success = false;
+    resp.message = "exact input-completion / drain barrier not satisfied";
+    return true;
+  }
+  boost::mutex::scoped_lock mapper_lock(smapper_mutex_);
+  std::string path;
+  nh_.getParam("b0_graph_output", path);
+  std::ofstream out(path);
+  out << std::setprecision(17);
+  auto pose = [&](const karto::Pose2& p) {
+    out << '[' << p.GetX() << ',' << p.GetY() << ',' << p.GetHeading() << ']';
+  };
+  auto graph = smapper_->getMapper()->GetGraph();
+  if (!out || !graph) {
+    resp.success = false;
+    resp.message = "missing output or graph";
+    return true;
+  }
+  out << "{\"nodes\":[";
+  bool first = true;
+  for (const auto& sensor : graph->GetVertices()) {
+    for (const auto& item : sensor.second) {
+      auto scan = item.second->GetObject();
+      if (!first) out << ',';
+      first = false;
+      out << "{\"id\":" << scan->GetUniqueId()
+          << ",\"state_id\":" << scan->GetStateId()
+          << ",\"time\":" << scan->GetTime() << ",\"odom\":";
+      pose(scan->GetOdometricPose());
+      out << ",\"corrected\":"; pose(scan->GetCorrectedPose());
+      out << ",\"sensor_pose\":"; pose(scan->GetSensorPose());
+      out << ",\"ranges\":[";
+      bool range_first = true;
+      for (double value : scan->GetRangeReadingsVector()) {
+        if (!range_first) out << ',';
+        range_first = false;
+        out << value;
+      }
+      out << "]}";
+    }
+  }
+  out << "],\"edges\":[";
+  first = true;
+  for (auto edge : graph->GetEdges()) {
+    if (!first) out << ',';
+    first = false;
+    auto info = dynamic_cast<karto::LinkInfo*>(edge->GetLabel());
+    out << "{\"source\":" << edge->GetSource()->GetObject()->GetUniqueId()
+        << ",\"target\":" << edge->GetTarget()->GetObject()->GetUniqueId();
+    if (info) {
+      out << ",\"measurement\":"; pose(info->GetPoseDifference());
+      out << ",\"covariance\":[";
+      for (int row = 0; row < 3; ++row) {
+        for (int col = 0; col < 3; ++col) {
+          if (row || col) out << ',';
+          out << info->GetCovariance()(row, col);
+        }
+      }
+      out << ']';
+    }
+    out << '}';
+  }
+  out << "]}\n";
+  out.close();
+  resp.success = out.good();
+  resp.message = path;
+  return true;
+}
